{
  "schema_name": "high_slope_attribute_data_dictionary",
  "schema_version": "0.2.0",
  "naming_convention": "snake_case",
  "source": {
    "title": "边坡属性表",
    "normalized_from": "Word表格及10条批注",
    "known_issues": [
      "原表中编号23复用于3个子字段（是否有防护工程、排水设施类型、防护设施类型）",
      "原表中编号43同时用于填报人和填报时间；建议填报时间规范化为44或完全改用稳定字段编码",
      "批注8缺少commentRangeStart/commentRangeEnd，仅有commentReference；结合所在段落位置，推断对应“贯通度下拉选项”",
      "字段20中的“左岸/右岸”以及字段21中的“植被是否有变形”在反馈中仍带问号，作为建议扩展字段保留",
      "字段23防护设施仅确定三大类，具体子类后续补充",
      "字段33浑浊程度、字段34设施损毁严重程度仍未给出枚举",
      "字段38、39监测位置及监测数据属于后续监测系统接入范围，当前结构仅为占位"
    ],
    "feedback": "根据甲方对15项待确认问题的图片批注更新"
  },
